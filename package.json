{
  "name": "countdown-widget",
  "version": "1.0.0",
  "private": true,
  "description": "A minimal glass-style countdown widget for the Windows desktop",
  "author": "countdown-widget",
  "license": "MIT",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dragtest": "electron . --dragtest",
    "verify": "node tools/verify.js",
    "shots": "node tools/shots.js",
    "icons": "node tools/make-icons.js",
    "icon": "node tools/make-icon.js",
    "dist": "electron-builder --win && node tools/postbuild.js",
    "dist:dir": "electron-builder --win dir && node tools/postbuild.js"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.countdown.widget",
    "productName": "Countdown",
    "copyright": "",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "assets/tray-light.png",
      "assets/tray-dark.png",
      "assets/icon.png",
      "assets/fonts/**/*",
      "package.json"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": ["tray-light.png", "tray-dark.png"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        },
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    }
  }
}
